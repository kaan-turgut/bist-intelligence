# Export these variables in your shell before running either pipeline.
BIST_FINANCE_DSN="dbname=bist_finance host=localhost user=postgres password=YOUR_PASSWORD"

# Activity report fact extraction and embeddings (bist.activity_reports.processor).
OPENAI_API_KEY="YOUR_API_KEY"

